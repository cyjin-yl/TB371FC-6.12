# New public-source downstream entry study; not V56/R201 or owner stock.
CONFIG_LOCALVERSION="-tb371fc-entry-r1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KEXEC=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# A self-contained rescue Image has no external module ABI/signing dependency.
# This scope reduction is for the first stage, not whole-device acceptance.
# CONFIG_MODULES is not set
# A separate deterministic initramfs is built from identified inputs.
CONFIG_INITRAMFS_SOURCE=""
# Generic virt console is an offline qualification aid, not tablet transport.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
