#!/bin/sh
# This candidate deliberately holds. It does not mount owner disks or kexec.
export PATH=/bin:/sbin
/bin/busybox --install -s /bin
mkdir -p /dev /proc /sys /run /tmp /dev/pts
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755 tmpfs /run
exec </dev/console >/dev/console 2>&1
echo "TB371FC_ENTRY_PID1: $(uname -r)"
echo "This is the new public-source entry study. No storage mount or payload auto-execution."
/bin/kexec --version

case " $(cat /proc/cmdline) " in
    *" tb371fc.entry_smoke=1 "*)
        # Generic QEMU qualification only. Never create a gadget in this mode.
        if ! /bin/kexec --version ||
           ! /bin/busybox sha256sum /bin/busybox /bin/kexec ||
           ! /bin/entry-return-bootloader --version; then
            echo TB371FC_QEMU_EL0_ERROR
            while :; do sleep 3600; done
        fi
        if [ -r /sys/kernel/kexec_loaded ]; then
            echo "TB371FC_ENTRY_KEXEC_LOADED=$(cat /sys/kernel/kexec_loaded)"
        else
            echo TB371FC_ENTRY_KEXEC_CAPABILITY_UNOBSERVED
        fi
        echo TB371FC_ENTRY_SMOKE_READY
        echo "TB371FC_QEMU_RELEASE=$(uname -r)"
        echo "TB371FC_QEMU_MACHINE=$(uname -m)"
        echo TB371FC_QEMU_EL0_READY
        while :; do sleep 3600; done
        ;;
esac

mkdir -p /sys/kernel/config
if mount -t configfs configfs /sys/kernel/config; then
    set -- /sys/class/udc/*
    if [ "$#" = 1 ] && [ -e "$1" ]; then
        udc=${1##*/}
        gadget=/sys/kernel/config/usb_gadget/tb371fc_entry
        if mkdir "$gadget"; then
            echo 0x1d6b >"$gadget/idVendor"
            echo 0x0104 >"$gadget/idProduct"
            mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
            echo "TB371FC entry research" >"$gadget/strings/0x409/manufacturer"
            echo "Public-source rescue ACM" >"$gadget/strings/0x409/product"
            echo "Local rescue console" >"$gadget/configs/c.1/strings/0x409/configuration"
            if mkdir "$gadget/functions/acm.GS0" &&
               ln -s "$gadget/functions/acm.GS0" "$gadget/configs/c.1/acm.GS0" &&
               echo "$udc" >"$gadget/UDC"; then
                echo "TB371FC_ENTRY_ACM_BOUND: $udc (host enumeration remains to be observed)"
                (
                    while :; do
                        setsid cttyhack sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1
                        sleep 1
                    done
                ) &
            else
                echo "TB371FC_ENTRY_ACM_FAILED: retaining existing console"
            fi
        fi
    else
        echo "TB371FC_ENTRY_UDC_UNRESOLVED: require exactly one enumerated UDC"
    fi
fi

echo TB371FC_ENTRY_HOLD
echo "No automatic kexec or restart. A physical recovery path must be qualified separately."
while :; do
    setsid cttyhack sh -i </dev/console >/dev/console 2>&1
    sleep 1
done
