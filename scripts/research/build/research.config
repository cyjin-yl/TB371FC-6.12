# New research ABI; never install these modules with an old R226 Image.
CONFIG_LOCALVERSION="-tb371fc-research1"
# CONFIG_LOCALVERSION_AUTO is not set
# Historical framebuffer/reset checkpoints are not a general-purpose boot profile.
# CONFIG_TB371FC_EARLY_FB_MARKER is not set
# CONFIG_TB371FC_LATE_FB_MARKER is not set
# CONFIG_TB371FC_POST_MMU_RESET_CHECKPOINT is not set
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NT36523_SPI=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_TB371FC_KTZ8866=m
CONFIG_DRM_PANEL_NOVATEK_NT36523=m
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_QCOM_VENUS=m
CONFIG_DRM_MSM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# VM preflight transports are separate from physical tablet qualification.
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
