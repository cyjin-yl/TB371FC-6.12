# Independent R5 service support, starting with the exact resolved R4 config.
# Each change is derived from the retained original Nura/NixOS service inputs.
CONFIG_LOCALVERSION="-tb371fc-research5-services"
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_RTC_DRV_PL031=y
CONFIG_ZRAM_BACKEND_ZSTD=y
