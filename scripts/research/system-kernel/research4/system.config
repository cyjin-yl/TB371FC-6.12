# Independent research4 ABI, based on frozen research2 plus input patches 0018/0019.
CONFIG_LOCALVERSION="-tb371fc-research4-system"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CGROUP_PIDS=y
CONFIG_AUTOFS_FS=m
CONFIG_GPIO_PL061=y
# ARM64 LSM attachment additionally uses dynamic ftrace direct-call sites.
# This enables patchable function entries, not a running function tracer.
# One probe-events implementation satisfies the hidden BPF_EVENTS dependency.
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
# CONFIG_UPROBE_EVENTS is not set
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
# CONFIG_FUNCTION_GRAPH_TRACER is not set
CONFIG_BPF_LSM=y
# Kernel BTF is needed for the actual systemd LSM program attachment.
CONFIG_DEBUG_KERNEL=y
# CONFIG_DEBUG_MISC is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_INFO_NONE is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_DWARF4=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# CONFIG_MODULE_ALLOW_BTF_MISMATCH is not set
# CONFIG_PROBE_EVENTS_BTF_ARGS is not set
