{
  "boot_requirements": [
    {
      "evidence": [
        "docs/research/2026-11-23/boot-readiness.md",
        "docs/research/2026-11-23/evidence/initramfs-validation.json",
        "docs/research/2026-11-23/evidence/research5-services-build.json"
      ],
      "id": "root_loader",
      "reason": "A real root-loading initramfs has not been qualified for this exact R5/native candidate; the prior generic VM archive/probe and Nura qemu-profile boot files do not establish that handoff. Its boot-argument handoff must preserve exactly one module.sig_enforce=1; R5 has CONFIG_MODULE_SIG_FORCE=n and native runtime enforcement is not established.",
      "status": "blocked"
    },
    {
      "evidence": [
        "docs/research/2026-11-23/boot-readiness.md",
        "docs/research/2026-11-23/evidence/research5-services-records/control/shared-transfer/bundle.json",
        "docs/research/2026-11-23/evidence/research5-services-records/control/shared-transfer/transfer.json"
      ],
      "id": "rootfs_modules_depmod",
      "reason": "The final native rootfs and its exact R5 module installation are unselected/unqualified. Regenerate and verify depmod indexes in that final root; the recorded kernel transfer deliberately excluded old depmod indexes.",
      "status": "blocked"
    },
    {
      "evidence": [
        "docs/research/2026-11-23/evidence/stock-firmware-staging.json",
        "docs/research/2026-11-23/evidence/research5-services-build.json",
        "docs/research/2026-11-23/evidence/initramfs-validation.json"
      ],
      "id": "firmware_candidate_binding",
      "reason": "A 69-file canonical ELF firmware tree already exists, but its recorded contract targets research2-display and has not been rebound and payload-verified in this exact R5 root/initramfs. R5 enables the joint input DT; do not repeat the older Novatek-disabled status. Firmware availability is not firmware loading or hardware acceptance.",
      "status": "blocked"
    },
    {
      "evidence": [
        "docs/research/2026-11-23/evidence/stock-firmware-staging.json"
      ],
      "id": "wlan_board_data",
      "reason": "The canonical tree preserves WLAN executable inputs; runtime board identity and the matching board-2.bin/board.bin are not established. Compiled support for unrelated WLAN adapters does not make their firmware a TB371FC requirement.",
      "status": "not_verified"
    },
    {
      "evidence": [
        "docs/research/2026-11-23/evidence/stock-firmware-staging.json"
      ],
      "id": "bluetooth_rom_selection",
      "reason": "Bluetooth ROM-specific firmware candidates are preserved, but the runtime ROM selection is not verified.",
      "status": "not_verified"
    },
    {
      "evidence": [
        "docs/research/2026-11-23/boot-readiness.md",
        "docs/research/2026-11-23/evidence/research5-services-build.json"
      ],
      "id": "native_entry_memory_layout",
      "reason": "A matched native first-stage/loader, image format, DMA quiescence and non-overlapping load/reserved-memory layout have not been qualified. Use ARM64 image_size and text_offset separately from stored Image length. The running Android kernel lacks the assumed kexec entry, and lock-state sources disagree. Actual native acceptance must verify the unique effective module.sig_enforce=1 boot argument and /sys/module/module/parameters/sig_enforce readback of Y or 1; configured FORCE=n or signed module bytes alone do not prove runtime enforcement.",
      "status": "blocked"
    },
    {
      "evidence": [
        "docs/research/2026-11-23/boot-readiness.md"
      ],
      "id": "reachable_recovery",
      "reason": "Eight current boot-related partitions have verified local/off-device backups; an actually reachable recovery/console and demonstrated restore/return path remain unverified. A backup alone is not recovery qualification.",
      "status": "blocked"
    },
    {
      "evidence": [
        "docs/research/2026-11-23/evidence/research5-services-verification.json",
        "docs/research/2026-11-23/boot-readiness.md"
      ],
      "id": "owner_native_linux",
      "reason": "The frozen R5 workflow records zero owner native-Linux runs/passes. Host build, transfer and generic VM evidence do not establish a tablet boot or whole-device operation.",
      "status": "not_verified"
    }
  ],
