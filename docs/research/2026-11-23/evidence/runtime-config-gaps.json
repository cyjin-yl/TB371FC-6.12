  "findings": [
    {
      "id": "pids-controller",
      "warning": "Failed to read pids.max for control group ..., ignoring: No data available",
      "count": 32,
      "classification": "missing kernel functionality; warning triggered while individual units are stopped",
      "root_cause": "CONFIG_CGROUP_PIDS=n excludes pids.o and the PIDs controller registration. systemd 262.1 unit_kill_context() reads pids.max before a SIGKILL phase to temporarily prevent new processes; cg_get_attribute_as_uint64() maps missing-file ENOENT to ENODATA.",
      "source_locations": [
        "kernel/cgroup/Makefile:5",
        "include/linux/cgroup_subsys.h:56-58",
        "kernel/cgroup/pids.c:395-401,454-463",
        "systemd v262.1 src/core/unit.c:5114-5140",
        "systemd v262.1 src/basic/cgroup-util.c:1433-1444"
      ],
      "timing": "First occurrences are in initrd-parse-etc and initrd-cleanup, before switch-root; later occurrences also accompany shutdown. Not merely a final power-off race.",
      "limitation": "The root cgroup intentionally lacks pids.max; these warnings name non-root unit cgroups. Individual warning lines alone cannot rule out cgroup removal, but controller absence is independently established.",
      "future_config": {
        "CONFIG_CGROUP_PIDS": "y"
      },
      "runtime_acceptance": [
        "pids present in /sys/fs/cgroup/cgroup.controllers",
        "pids.max readable in an active non-root service cgroup",
        "no pids.max warning in the complete new generic-VM serial log"
      ]
    },
    {
      "id": "autofs",
      "warning": "Failed to find module 'autofs4'",
      "count": 2,
      "classification": "missing kernel automount implementation",
      "root_cause": "CONFIG_AUTOFS_FS=n. Linux 6.12.114 fs/autofs/Makefile builds autofs4.o from CONFIG_AUTOFS_FS; systemd kmod-setup explicitly asks for autofs4 before udev can auto-load it.",
      "source_locations": [
        "fs/autofs/Kconfig:1",
        "fs/autofs/Makefile:6-8",
        "systemd v262.1 src/core/kmod-setup.c:186-189"
      ],
      "future_config": {
        "CONFIG_AUTOFS_FS": "m"
      },
      "runtime_acceptance": [
        "autofs4.ko installed with the exact new release and included in initramfs",
        "/sys/class/misc/autofs exists after module load",
        "no autofs4 missing-module warning in new log"
      ],
      "limitation": "A boot without failed units does not establish that automount units work."
    },
    {
      "id": "bpf-lsm",
      "warning": "bpf-restrict-fs: BPF LSM hook not enabled in the kernel, BPF LSM not supported.",
      "count": 2,
      "classification": "missing optional BPF LSM filesystem-restriction functionality",
      "root_cause": "The LSM order string includes bpf but CONFIG_BPF_LSM is not enabled. BPF_LSM depends on BPF_EVENTS; BPF_EVENTS is inside FTRACE and needs (KPROBE_EVENTS || UPROBE_EVENTS) && PERF_EVENTS. Current FTRACE=n and KPROBES=n prevent that chain.",
      "source_locations": [
        "kernel/bpf/Kconfig:92-102",
