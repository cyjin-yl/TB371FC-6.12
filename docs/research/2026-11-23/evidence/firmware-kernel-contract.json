  "mdt_contract": {
    "format_rule": "This loader interprets the ELF32 header/program-header layout. The .mbn/.mdt/.elf suffix does not select parsing; header/program-header data determine its behavior.",
    "metadata_rule": [
      "Require a non-PT_LOAD first program header and a later QCOM hash segment.",
      "If first-header p_filesz plus hash p_filesz equals main file size, read packed hash immediately after first-header bytes.",
      "Otherwise read hash at its declared offset when fully inside the main file.",
      "Otherwise request the hash segment indexed bNN."
    ],
    "name_rule": "Replace the final three characters of the requested main filename with b%02d, using the original decimal ELF program-header index, in the same directory.",
    "not_claimed": "No bundle byte content, signatures, authentication, runtime firmware ABI, DSP protocols or hardware operation are validated by this static contract.",
    "payload_rule": "Load only PT_LOAD, non-QCOM-MDT-hash entries with nonzero p_memsz. In split mode each such nonempty p_filesz needs its indexed bNN, even if that payload would fit inside the main file. BSS is zero-filled.",
    "size_checks": "Payload p_filesz must not exceed p_memsz; split file size must match p_filesz; destination must fit the reserved region.",
    "source": "drivers/soc/qcom/mdt_loader.c",
    "split_rule": "Inspect all program headers with nonzero p_filesz, including hash/non-PT_LOAD entries. Any segment start or end beyond the main file makes the image split. Zero-file-size BSS entries do not trigger split."
  },
