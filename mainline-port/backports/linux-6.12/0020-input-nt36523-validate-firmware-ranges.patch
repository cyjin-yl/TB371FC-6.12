From: TB371FC research contributors <tb371fc-research@localhost>
Subject: [PATCH] input: nt36523: validate firmware metadata and inclusive payload ranges

Bounds-check every header before decoding it. Keep partition counts wide and
bounded by the checksum transfer buffer, and allocate their map with kcalloc.
Both software and hardware CRC paths must validate the complete size + 1
payload using subtraction, without wrapping 32-bit firmware offsets. Repeat
that check before copying the bytes into the SPI staging buffer.

Decode little-endian words through unsigned shifts. Preserve unused (size
zero) entries and the existing cascade/overlay record ordering. No firmware
payload, board GPIO, device timing, or download protocol is changed.

Applies after 0019-input-nt36523-fail-closed-and-release-resources.patch.

diff --git a/drivers/input/touchscreen/nt36523/nt36xxx_fw_update.c b/drivers/input/touchscreen/nt36523/nt36xxx_fw_update.c
--- a/drivers/input/touchscreen/nt36523/nt36xxx_fw_update.c
+++ b/drivers/input/touchscreen/nt36523/nt36xxx_fw_update.c
@@ -108,7 +108,7 @@
 *******************************************************/
 static uint32_t CheckSum(const u8 *data, size_t len)
 {
-	uint32_t i = 0;
+	size_t i;
 	uint32_t checksum = 0;
 
 	for (i = 0 ; i < len+1 ; i++)
@@ -122,7 +122,22 @@
 
 static uint32_t byte_to_word(const uint8_t *data)
 {
-	return data[0] + (data[1] << 8) + (data[2] << 16) + (data[3] << 24);
+	return (uint32_t)data[0] | ((uint32_t)data[1] << 8) |
+	       ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);
+}
+
+static bool nvt_fw_range_valid(size_t fwsize, size_t offset, size_t length)
+{
+	return offset <= fwsize && length <= fwsize - offset;
+}
+
+static bool nvt_fw_partition_valid(size_t fwsize, uint32_t offset,
+				   uint32_t size)
+{
+	/* Zero denotes an unused partition; active sizes encode length minus one. */
+	if (!size)
+		return true;
+	return size != U32_MAX && offset < fwsize && size < fwsize - offset;
 }
 
 /*******************************************************
@@ -138,35 +153,27 @@
 static int32_t nvt_bin_header_parser(const u8 *fwdata, size_t fwsize)
 {
 	uint32_t list = 0;
-	uint32_t pos = 0x00;
-	uint32_t end = 0x00;
-	uint8_t info_sec_num = 0;
+	size_t pos = 0, end, info_end;
+	uint32_t info_sec_num;
 	uint8_t ovly_sec_num = 0;
 	uint8_t ovly_info = 0;
 	uint8_t find_bin_header = 0;
 
-	/* Find the header size */
-	end = fwdata[0] + (fwdata[1] << 8) + (fwdata[2] << 16) + (fwdata[3] << 24);
+	/* The fixed header includes both base records and flags through 0x28. */
+	if (!nvt_fw_range_valid(fwsize, 0, 0x30))
+		return -EINVAL;
+	end = byte_to_word(fwdata);
+	if (end < 0x30 || end > fwsize)
+		return -EINVAL;
 
 	/* check cascade next header */
 	cascade_2nd_header_info = (fwdata[0x20] & 0x02) >> 1;
 	NVT_LOG("cascade_2nd_header_info = %d\n", cascade_2nd_header_info);
 
-	if (cascade_2nd_header_info) {
-		pos = 0x30;	// info section start at 0x30 offset
-		while (pos < (end / 2)) {
-			info_sec_num ++;
-			pos += 0x10;	/* each header info is 16 bytes */
-		}
-
-		info_sec_num = info_sec_num + 1; //next header section
-	} else {
-		pos = 0x30;	// info section start at 0x30 offset
-		while (pos < end) {
-			info_sec_num ++;
-			pos += 0x10;	/* each header info is 16 bytes */
-		}
-	}
+	info_end = cascade_2nd_header_info ? end / 2 : end;
+	info_sec_num = info_end > 0x30 ? DIV_ROUND_UP(info_end - 0x30, 0x10) : 0;
+	if (cascade_2nd_header_info)
+		info_sec_num++;
 
 	/*
 	 * Find the DLM OVLY section
@@ -181,13 +188,16 @@
 	 * ilm_dlm_num (ILM & DLM) + ovly_sec_num + info_sec_num
 	 */
 	partition = ilm_dlm_num + ovly_sec_num + info_sec_num;
+	/* nvt_check_fw_checksum() reads four bytes per partition into fwbuf. */
+	if (partition > NVT_TRANSFER_LEN / sizeof(uint32_t))
+		return -EINVAL;
 	NVT_LOG("ovly_info = %d, ilm_dlm_num = %d, ovly_sec_num = %d, info_sec_num = %d, partition = %d\n",
 			ovly_info, ilm_dlm_num, ovly_sec_num, info_sec_num, partition);
 
 	/* allocated memory for header info */
-	bin_map = (struct nvt_ts_bin_map *)kzalloc((partition+1) * sizeof(struct nvt_ts_bin_map), GFP_KERNEL);
+	bin_map = kcalloc(partition + 1, sizeof(*bin_map), GFP_KERNEL);
 	if(bin_map == NULL) {
-		NVT_ERR("kzalloc for bin_map failed!\n");
+		NVT_ERR("kcalloc for bin_map failed!\n");
 		return -ENOMEM;
 	}
 
@@ -203,15 +213,6 @@
 			bin_map[list].size = byte_to_word(&fwdata[8 + list*12]);
 			if (ts->hw_crc)
 				bin_map[list].crc = byte_to_word(&fwdata[0x18 + list*4]);
-			else { //ts->hw_crc
-				if ((bin_map[list].BIN_addr + bin_map[list].size) < fwsize)
-					bin_map[list].crc = CheckSum(&fwdata[bin_map[list].BIN_addr], bin_map[list].size);
-				else {
-					NVT_ERR("access range (0x%08X to 0x%08X) is larger than bin size!\n",
-							bin_map[list].BIN_addr, bin_map[list].BIN_addr + bin_map[list].size);
-					return -EINVAL;
-				}
-			} //ts->hw_crc
 			if (list == 0)
 				sprintf(bin_map[list].name, "ILM");
 			else if (list == 1)
@@ -230,27 +231,21 @@
 				/* cascade 2nd header info */
 				pos = end - 0x10;
 			}
+			if (!nvt_fw_range_valid(end, pos, 0x10))
+				return -EINVAL;
 
 			bin_map[list].SRAM_addr = byte_to_word(&fwdata[pos]);
 			bin_map[list].size = byte_to_word(&fwdata[pos+4]);
 			bin_map[list].BIN_addr = byte_to_word(&fwdata[pos+8]);
 			if (ts->hw_crc)
 				bin_map[list].crc = byte_to_word(&fwdata[pos+12]);
-			else { //ts->hw_crc
-				if ((bin_map[list].BIN_addr + bin_map[list].size) < fwsize)
-					bin_map[list].crc = CheckSum(&fwdata[bin_map[list].BIN_addr], bin_map[list].size);
-				else {
-					NVT_ERR("access range (0x%08X to 0x%08X) is larger than bin size!\n",
-							bin_map[list].BIN_addr, bin_map[list].BIN_addr + bin_map[list].size);
-					return -EINVAL;
-				}
-			} //ts->hw_crc
 			/* detect header end to protect parser function */
 			if ((bin_map[list].BIN_addr < end) && (bin_map[list].size != 0)) {
 				sprintf(bin_map[list].name, "Header");
 				find_bin_header = 1;
 			} else {
-				sprintf(bin_map[list].name, "Info-%d", (list - ilm_dlm_num));
+				snprintf(bin_map[list].name, sizeof(bin_map[list].name),
+					 "Info-%u", list - ilm_dlm_num);
 			}
 		}
 
@@ -260,31 +255,30 @@
 		 */
 		if (list >= (ilm_dlm_num + info_sec_num)) {
 			/* overlay info located at DLM (list = 1) start addr */
-			pos = bin_map[1].BIN_addr + (0x10 * (list- ilm_dlm_num - info_sec_num));
+			pos = 0x10 * (list - ilm_dlm_num - info_sec_num);
+			if (!nvt_fw_range_valid(fwsize, bin_map[1].BIN_addr,
+						pos + 0x10))
+				return -EINVAL;
+			pos += bin_map[1].BIN_addr;
 
 			bin_map[list].SRAM_addr = byte_to_word(&fwdata[pos]);
 			bin_map[list].size = byte_to_word(&fwdata[pos+4]);
 			bin_map[list].BIN_addr = byte_to_word(&fwdata[pos+8]);
 			if (ts->hw_crc)
 				bin_map[list].crc = byte_to_word(&fwdata[pos+12]);
-			else { //ts->hw_crc
-				if ((bin_map[list].BIN_addr + bin_map[list].size) < fwsize)
-					bin_map[list].crc = CheckSum(&fwdata[bin_map[list].BIN_addr], bin_map[list].size);
-				else {
-					NVT_ERR("access range (0x%08X to 0x%08X) is larger than bin size!\n",
-							bin_map[list].BIN_addr, bin_map[list].BIN_addr + bin_map[list].size);
-					return -EINVAL;
-				}
-			} //ts->hw_crc
-			sprintf(bin_map[list].name, "Overlay-%d", (list- ilm_dlm_num - info_sec_num));
-		}
-
-		/* BIN size error detect */
-		if ((bin_map[list].BIN_addr + bin_map[list].size) > fwsize) {
-			NVT_ERR("access range (0x%08X to 0x%08X) is larger than bin size!\n",
-					bin_map[list].BIN_addr, bin_map[list].BIN_addr + bin_map[list].size);
+			snprintf(bin_map[list].name, sizeof(bin_map[list].name),
+				 "Overlay-%u", list - ilm_dlm_num - info_sec_num);
+		}
+
+		/* Validate before either checksum or later size + 1 SPI transfer. */
+		if (!nvt_fw_partition_valid(fwsize, bin_map[list].BIN_addr,
+					    bin_map[list].size)) {
+			NVT_ERR("partition %u exceeds firmware bounds\n", list);
 			return -EINVAL;
 		}
+		if (!ts->hw_crc && bin_map[list].size)
+			bin_map[list].crc = CheckSum(&fwdata[bin_map[list].BIN_addr],
+						    bin_map[list].size);
 
 //		NVT_LOG("[%d][%s] SRAM (0x%08X), SIZE (0x%08X), BIN (0x%08X), CRC (0x%08X)\n",
 //				list, bin_map[list].name,
@@ -452,9 +446,8 @@
 //				list, name, SRAM_addr, size, BIN_addr);
 
 		/* Check data size */
-		if ((BIN_addr + size) > fwsize) {
-			NVT_ERR("access range (0x%08X to 0x%08X) is larger than bin size!\n",
-					BIN_addr, BIN_addr + size);
+		if (!nvt_fw_partition_valid(fwsize, BIN_addr, size)) {
+			NVT_ERR("partition %u exceeds firmware bounds\n", list);
 			ret = -EINVAL;
 			goto out;
 		}
