 	nvt_irq_enable(true);
+	pm_relax(&client->dev);
 
 	return 0;
 err_alloc_work_thread_failed:
@@ -1681,6 +1709,9 @@
 	}
 err_create_nvt_esd_check_wq_failed:
 #endif
+err_firmware_init_failed:
+	bTouchIsAwake = 0;
+	pm_relax(&client->dev);
 	free_irq(client->irq, ts);
 err_int_request_failed:
 	if (ts->pen_support) {
@@ -1739,6 +1770,15 @@
 {
 	NVT_LOG("Removing driver...\n");
 
+	/* Drain event work before it can re-enable IRQs or requeue ESD work. */
+	if (ts->event_wq) {
+		destroy_workqueue(ts->event_wq);
+		ts->event_wq = NULL;
+	}
+	nvt_irq_enable(false);
+	if (nvt_irq_set_wake(false))
+		dev_warn(&client->dev, "failed to disarm IRQ wake on removal\n");
+
 #if NVT_TOUCH_ESD_PROTECT
 	if (nvt_esd_check_wq) {
 		cancel_delayed_work_sync(&nvt_esd_check_work);
@@ -1748,8 +1788,8 @@
 	}
 #endif
 
-	nvt_irq_enable(false);
 	free_irq(client->irq, ts);
+	bTouchIsAwake = 0;
 
 	mutex_destroy(&ts->xbuf_lock);
 	mutex_destroy(&ts->lock);
@@ -1771,6 +1811,8 @@
 	spi_set_drvdata(client, NULL);
 
 	if (ts) {
+		kfree(ts->rbuf);
+		kfree(ts->xbuf);
 		kfree(ts);
 		ts = NULL;
 	}
@@ -1780,9 +1822,13 @@
 {
 	NVT_LOG("Shutdown driver...\n");
 
+	if (ts->event_wq) {
+		destroy_workqueue(ts->event_wq);
+		ts->event_wq = NULL;
+	}
 	nvt_irq_enable(false);
-
-	destroy_workqueue(ts->event_wq);
+	if (nvt_irq_set_wake(false))
+		dev_warn(&client->dev, "failed to disarm IRQ wake\n");
 
 #if NVT_TOUCH_ESD_PROTECT
 	if (nvt_esd_check_wq) {
@@ -1804,60 +1850,48 @@
 static int32_t nvt_ts_suspend(struct device *dev)
 {
 	uint8_t buf[4] = {0};
+	int ret;
+	bool pen_disabled = false;
 #if MT_PROTOCOL_B
 	uint32_t i = 0;
 #endif
 
-	if (!bTouchIsAwake) {
-		NVT_LOG("Touch is already suspend\n");
+	if (!bTouchIsAwake)
 		return 0;
-	}
 
 	pm_stay_awake(dev);
-	ts->ic_state = NVT_IC_SUSPEND_IN;
-
-	if (!ts->db_wakeup) {
-		if (!ts->irq_enabled)
-			NVT_LOG("IRQ already disabled\n");
-		else
-			nvt_irq_enable(false);
-	}
-
+	/* disable_irq() may wait for the IRQ thread, which takes ts->lock. */
+	nvt_irq_enable(false);
 #if NVT_TOUCH_ESD_PROTECT
-	NVT_LOG("cancel delayed work sync\n");
 	cancel_delayed_work_sync(&nvt_esd_check_work);
 	nvt_esd_check_enable(false);
-#endif /* #if NVT_TOUCH_ESD_PROTECT */
-
+#endif
 	mutex_lock(&ts->lock);
-
-	NVT_LOG("suspend start\n");
-
-	if (ts->pen_input_dev_enable) {
-		NVT_LOG("if enable pen,will close it");
-		disable_pen_input_device(true);
-	}
-
-	bTouchIsAwake = 0;
+	ts->ic_state = NVT_IC_SUSPEND_IN;
+
+	if (ts->pen_support && ts->pen_input_dev_enable) {
+		pen_disabled = true;
+		ret = disable_pen_input_device(true);
+		if (ret)
+			goto rollback;
+	}
 
 	if (ts->db_wakeup) {
-		/*---write command to enter "wakeup gesture mode"---*/
-		/*DoubleClick wakeup CMD was sent by display to meet timing*/
-		/*
-		buf[0] = EVENT_MAP_HOST_CMD;
-		buf[1] = 0x13;
-		CTP_SPI_WRITE(ts->client, buf, 2);
-		*/
-		enable_irq_wake(ts->client->irq);
-
-		NVT_LOG("Enabled touch wakeup gesture\n");
+		/* Gesture entry is still a display-side protocol prerequisite. */
+		ret = nvt_irq_set_wake(true);
 	} else {
-		/*---write command to enter "deep sleep mode"---*/
+		ret = nvt_set_page(ts->mmap->EVENT_BUF_ADDR | EVENT_MAP_HOST_CMD);
+		if (ret)
+			goto rollback;
 		buf[0] = EVENT_MAP_HOST_CMD;
 		buf[1] = 0x11;
-		CTP_SPI_WRITE(ts->client, buf, 2);
-	}
-
+		ret = CTP_SPI_WRITE(ts->client, buf, 2);
+	}
+	if (ret)
+		goto rollback;
+
+	bTouchIsAwake = 0;
+	ts->ic_state = NVT_IC_SUSPEND_OUT;
 	mutex_unlock(&ts->lock);
 
 	/* release all touches */
@@ -1874,18 +1908,26 @@
 	input_mt_sync(ts->input_dev);
 #endif
 	input_sync(ts->input_dev);
-
 	msleep(50);
-	/* release pen event */
 	release_pen_event();
-	if (likely(ts->ic_state == NVT_IC_SUSPEND_IN))
-		ts->ic_state = NVT_IC_SUSPEND_OUT;
-	else
-		NVT_ERR("IC state may error,caused by suspend/resume flow, please CHECK!!");
+	if (ts->irq_wake_enabled)
+		nvt_irq_enable(true);
 	pm_relax(dev);
-	NVT_LOG("end\n");
-
 	return 0;
+
+rollback:
+	/* Abort suspend without leaving a software-only "asleep" state. */
+	if (pen_disabled && disable_pen_input_device(false))
+		dev_warn(dev, "failed to restore pen after aborted suspend\n");
+	ts->ic_state = NVT_IC_RESUME_OUT;
+	mutex_unlock(&ts->lock);
+#if NVT_TOUCH_ESD_PROTECT
+	queue_delayed_work(nvt_esd_check_wq, &nvt_esd_check_work,
+			msecs_to_jiffies(NVT_TOUCH_ESD_CHECK_PERIOD));
+#endif
+	nvt_irq_enable(true);
+	pm_relax(dev);
+	return ret;
 }
 
 /*******************************************************
@@ -1893,65 +1935,66 @@
 	Novatek touchscreen driver resume function.
 
 return:
-	Executive outcomes. 0---succeed.
+	Zero only after firmware, reset handshake and pen setup succeed.
 *******************************************************/
 static int32_t nvt_ts_resume(struct device *dev)
 {
-	int ret = 0;
-	if (bTouchIsAwake) {
-		NVT_LOG("Touch is already resume\n");
+	int ret;
+
+	if (bTouchIsAwake)
 		return 0;
-	}
-
-	if (ts->dev_pm_suspend)
-		pm_stay_awake(dev);
+
+	pm_stay_awake(dev);
+	nvt_irq_enable(false);
+	ret = nvt_irq_set_wake(false);
+	if (ret)
+		goto out_relax;
 
 	mutex_lock(&ts->lock);
-
-	NVT_LOG("resume start\n");
 	ts->ic_state = NVT_IC_RESUME_IN;
 
-	// please make sure display reset(RESX) sequence and mipi dsi cmds sent before this
+	/* Display reset and DSI commands must precede touchscreen restart. */
 #if NVT_TOUCH_SUPPORT_HW_RST
 	gpiod_set_value_cansleep(ts->reset_gpio, 0);
 #endif
 	ret = nvt_update_firmware(ts->fw_name);
 	if (ret)
-		NVT_ERR("download firmware failed\n");
-
-	nvt_check_fw_reset_state(RESET_STATE_REK);
-
-	if (!ts->db_wakeup && !ts->irq_enabled) {
-		nvt_irq_enable(true);
-	}
+		goto failed;
+	ret = nvt_check_fw_reset_state(RESET_STATE_REK);
+	if (ret)
+		goto failed;
+
+	/* The pen helper requires an awake controller; roll back on failure. */
+	bTouchIsAwake = 1;
+	if (ts->pen_support) {
+		ret = disable_pen_input_device(false);
+		if (ret)
+			goto failed;
+	}
+	ts->ic_state = NVT_IC_RESUME_OUT;
+	if (ts->gesture_command_delayed >= 0) {
+		ts->db_wakeup = ts->gesture_command_delayed;
+		ts->gesture_command_delayed = -1;
+	}
+	mutex_unlock(&ts->lock);
 
 #if NVT_TOUCH_ESD_PROTECT
 	nvt_esd_check_enable(false);
 	queue_delayed_work(nvt_esd_check_wq, &nvt_esd_check_work,
 			msecs_to_jiffies(NVT_TOUCH_ESD_CHECK_PERIOD));
-#endif /* #if NVT_TOUCH_ESD_PROTECT */
-
-	bTouchIsAwake = 1;
-
+#endif
+	nvt_irq_enable(true);
+	pm_relax(dev);
+	return 0;
+
+failed:
+	/* Keep a failed restart quiescent, and allow a later explicit retry. */
+	bTouchIsAwake = 0;
+	ts->ic_state = NVT_IC_SUSPEND_OUT;
 	mutex_unlock(&ts->lock);
-
-	disable_pen_input_device(false);
-	if (likely(ts->ic_state == NVT_IC_RESUME_IN)) {
-		ts->ic_state = NVT_IC_RESUME_OUT;
-	} else {
-		NVT_ERR("IC state may error,caused by suspend/resume flow, please CHECK!!");
-	}
-	if (ts->gesture_command_delayed >= 0){
-		ts->db_wakeup = ts->gesture_command_delayed;
-		ts->gesture_command_delayed = -1;
-		NVT_LOG("execute delayed command, set double click wakeup %d\n", ts->db_wakeup);
-	}
-
-	if (ts->dev_pm_suspend)
-		pm_relax(dev);
-	NVT_LOG("end\n");
-
-	return 0;
+out_relax:
+	pm_relax(dev);
+	return ret;
 }
 
 
@@ -1971,6 +2014,11 @@
 
 static int nvt_pm_resume(struct device *dev)
 {
+	/*
+	 * This completion releases the transport-PM wait in the IRQ thread.
+	 * Signal it before nvt_ts_resume() synchronously disables the IRQ;
+	 * controller readiness is tracked separately by bTouchIsAwake.
+	 */
 	ts->dev_pm_suspend = false;
 	complete(&ts->dev_pm_suspend_completion);
 
