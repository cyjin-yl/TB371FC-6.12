+			ts->int_trigger_type | IRQF_ONESHOT | IRQF_NO_AUTOEN,
+			NVT_SPI_NAME, ts);
+	if (ret) {
+		NVT_ERR("request irq failed. ret=%d\n", ret);
+		goto err_int_request_failed;
 	}
 
 	ts->pen_is_charge = false;
@@ -1637,9 +1654,21 @@
 
 #if BOOT_UPDATE_FIRMWARE
 	ret = nvt_update_firmware(ts->fw_name);
+	if (ret) {
+		NVT_ERR("download firmware failed\n");
+		goto err_firmware_init_failed;
+	}
+#endif
+	ret = nvt_check_fw_reset_state(RESET_STATE_REK);
 	if (ret)
-		NVT_ERR("download firmware failed\n");
-#endif
+		goto err_firmware_init_failed;
+
+	bTouchIsAwake = 1;
+	if (ts->pen_support) {
+		ret = disable_pen_input_device(false);
+		if (ret)
+			goto err_firmware_init_failed;
+	}
 
 	NVT_LOG("NVT_TOUCH_ESD_PROTECT is %d\n", NVT_TOUCH_ESD_PROTECT);
 #if NVT_TOUCH_ESD_PROTECT
@@ -1664,11 +1693,10 @@
 	INIT_WORK(&ts->resume_work, nvt_resume_work);
 	INIT_WORK(&ts->suspend_work, nvt_suspend_work);
 
-	bTouchIsAwake = 1;
-	disable_pen_input_device(false);
