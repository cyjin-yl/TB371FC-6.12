Subject: [PATCH] drm/panel: tb371fc: match observed Tianma OFF transport

The owner Tianma DT OFF table sends Display Off in HS, waits 15 ms,
sends Enter Sleep in HS, then waits 60 ms. The generic disable path
uses the LP mode flag and one final 70 ms wait, and discards errors.

Scope the observed sequence to the Tianma descriptor only. Attempt
both device calls and both stages even when a transfer fails, restore
each device's previous flags, and retain the first error in the helper.
The disable callback reports that error but completes the lifecycle:
the panel bridge cannot abort teardown, and returning an error would
leave drm_panel.enabled set and skip the backlight on the next enable.
The BOE and other panels retain their existing disable behavior. This
is an isolated candidate, not physical panel or suspend qualification.

diff --git a/drivers/gpu/drm/panel/panel-novatek-nt36523.c b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c
@@ -1294,28 +1294,81 @@
 	return 0;
 }
 
-static int nt36523_disable(struct drm_panel *panel)
-{
-	struct panel_info *pinfo = to_panel_info(panel);
-	int i;
-
-	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
-		struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i]};
-
-		mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
-	}
-
-	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
-		struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i]};
-
-		mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
-	}
-
-	msleep(70);
-
-	return 0;
-}
-
+/* The owner Tianma OFF table is HS: Display Off, 15 ms, Sleep In, 60 ms. */
+static int tb371fc_tianma_off_stage(struct panel_info *pinfo, bool sleep)
+{
+	int first_error = 0;
+	int i;
+
+	/* Try both halves even when one host fails. */
+	for (i = 0; i < 2; i++) {
+		struct mipi_dsi_device *dsi = pinfo->dsi[i];
+		struct mipi_dsi_multi_context ctx = { .dsi = dsi };
+		unsigned long saved_flags = dsi->mode_flags;
+
+		dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		if (sleep)
+			mipi_dsi_dcs_enter_sleep_mode_multi(&ctx);
+		else
+			mipi_dsi_dcs_set_display_off_multi(&ctx);
+		dsi->mode_flags = saved_flags;
+
+		if (ctx.accum_err && !first_error)
+			first_error = ctx.accum_err;
+	}
+
+	return first_error;
+}
+
+static int tb371fc_tianma_disable(struct panel_info *pinfo)
+{
+	int ret, sleep_ret;
+
+	ret = tb371fc_tianma_off_stage(pinfo, false);
+	msleep(15);
+	sleep_ret = tb371fc_tianma_off_stage(pinfo, true);
+	msleep(60);
+
+	return ret ? ret : sleep_ret;
+}
+
+static int nt36523_disable(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	int i, ret;
+
+	if (pinfo->desc == &tb371fc_tianma_desc) {
+		ret = tb371fc_tianma_disable(pinfo);
+		if (ret)
+			dev_err(panel->dev,
+				"Tianma OFF sequence failed: %d; continuing power-off\n",
+				ret);
+
+		/*
+		 * The panel bridge still unprepares after disable errors. Let
+		 * drm_panel_disable() clear enabled so a later enable can
+		 * restore the backlight after the reset/power-off cycle.
+		 */
+		return 0;
+	}
+
+	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
+		struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i]};
+
+		mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	}
+
+	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
+		struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i]};
+
+		mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	}
+
+	msleep(70);
+
+	return 0;
+}
+
 static int nt36523_unprepare(struct drm_panel *panel)
 {
 	struct panel_info *pinfo = to_panel_info(panel);
